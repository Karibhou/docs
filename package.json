{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "tsx scripts/run-sync-step.ts scripts/update-meeting-recordings.ts && tsx scripts/run-sync-step.ts scripts/sync-hive-docs.ts && tsx scripts/run-sync-step.ts scripts/sync-sibling-docs.ts && tsx scripts/generate-shared-config.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/ scripts/ netlify/",
    "lint:fix": "eslint src/ scripts/ netlify/ --fix",
    "lint:md": "markdownlint-cli2 \"README.md\" \"CONTRIBUTING.md\" \"docs/**/*.{md,mdx}\" \"src/**/*.{md,mdx}\"",
    "sync-hive-docs": "tsx scripts/sync-hive-docs.ts",
    "sync-sibling-docs": "tsx scripts/sync-sibling-docs.ts",
    "check-links": "tsx scripts/check-internal-links.ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true npm run build",
    "clean": "rm -rf .next out",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=moderate",
    "update-deps": "npm update && npm audit fix"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.6",
    "@theguild/remark-mermaid": "^0.3.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.57.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.1",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^30.1.3",
    "markdownlint": "^0.42.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "overrides": {
    "@xmldom/xmldom": ">=0.9.10",
    "axios": ">=1.16.0",
    "brace-expansion": "^2.1.7",
    "dompurify": ">=3.4.17",
    "linkify-it": ">=5.0.2",
    "lodash-es": ">=4.18.0",
    "smol-toml": ">=1.9.0",
    "follow-redirects": ">=1.16.0",
    "js-yaml": ">=5.2.2",
    "markdown-it": ">=15.0.3",
    "undici": ">=8.12.2",
    "nanoid": ">=3.3.17",
    "postcss": ">=8.5.18",
    "sharp": ">=0.35.3",
    "uuid": ">=11.1.1",
    "minimatch": "3.1.4",
    "katex": "^0.18.2"
  }
}
